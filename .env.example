# Copy to .env and adjust as needed.
# All variables use the REMUXARR_ prefix.
#
# Every value below already matches the app's own built-in default — an
# untouched .env, with nothing uncommented, works completely fine. This
# file is only for the handful of cases you actually want to override.
#
# Note: worker concurrency (max concurrent jobs) is NOT set here — it's
# a runtime setting, changeable from Settings > Worker in the web UI
# itself, not an environment variable.

REMUXARR_DATABASE_PATH=/config/remuxarr.db
REMUXARR_DEBUG=false

REMUXARR_FFMPEG_PATH=ffmpeg
REMUXARR_FFPROBE_PATH=ffprobe

# Seconds to wait after the last webhook for a given file before queuing it.
# Increase for very large season packs on slow disks.
REMUXARR_WEBHOOK_DEBOUNCE_SECONDS=10

REMUXARR_TEMP_DIR=/tmp/remuxarr

# Recycle bin for "revert to original". Must be a real mount that survives
# restarts — NOT under /tmp, which is RAM-backed. If the path does not exist
# the recycle bin stays off and the app says why, rather than writing into
# the container's own filesystem where sidecars would vanish on the next
# image pull.
REMUXARR_RECYCLE_DIR=/recycle

# REMUXARR_VERSION and REMUXARR_COMMIT exist and are deliberately not listed
# above as settings you fill in. The Dockerfile stamps them from build args so
# the running image can say which build it is, in the UI and at /api/health.
# Setting them by hand would work and would produce an image that reports a
# build it is not, which is worse than the "dev"/"unknown" a source checkout
# reports honestly. They are noted here only so that a reader comparing this
# file against app/config.py does not find two undocumented fields and assume
# an oversight.
