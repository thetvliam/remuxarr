<?xml version="1.0"?>
<Container version="2">
  <Name>Remuxarr</Name>
  <Repository>thetvliam/remuxarr:latest</Repository>
  <Registry>https://hub.docker.com/r/thetvliam/remuxarr</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>

  <Icon>https://raw.githubusercontent.com/thetvliam/remuxarr/main/images_and_demo/logo_transparent.png</Icon>

  <!-- The port here is the CONTAINER port, not the host port. -->
  <WebUI>http://[IP]:[PORT:9191]</WebUI>

  <Overview>
    Cleans up a Sonarr/Radarr media library for better direct-play compatibility, without ever re-encoding video. Remuxes containers (MKV to MP4 when every track inside is already compatible), drops audio and subtitle tracks outside your chosen languages, and fixes broken or missing language metadata. Everything is done by lossless stream copy, so the video data itself is never touched.

    Integrates with Sonarr, Radarr and Plex. After first start, set your library paths and preferred languages in Settings. Dry-run mode is on by default, so the first scan shows exactly what would happen to every file before anything is changed for real.
  </Overview>

  <Support>https://github.com/thetvliam/remuxarr/issues</Support>
  <Project>https://github.com/thetvliam/remuxarr</Project>
  <TemplateURL>https://raw.githubusercontent.com/thetvliam/remuxarr/main/templates/remuxarr.xml</TemplateURL>

  <Category>MediaApp:Video Tools:Utilities</Category>

  <!-- Web UI port -->
  <Config Name="WebUI" Target="9191" Default="9191" Mode="tcp" Description="HTTP port for the web UI and API." Type="Port" Display="always" Required="true" Mask="false"/>

  <!-- Persistent config and database -->
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/remuxarr/config" Mode="rw" Description="Persistent settings and database. Must survive container updates." Type="Path" Display="always" Required="true" Mask="false"/>

  <!-- Media library -->
  <Config Name="Movies" Target="/media/movies" Default="/mnt/user/media/movies" Mode="rw" Description="Your movies library." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="TV Shows" Target="/media/tv" Default="/mnt/user/media/tv" Mode="rw" Description="Your TV library." Type="Path" Display="always" Required="true" Mask="false"/>

  <!-- FFmpeg staging. Keep this under /tmp so it stays RAM-backed on Unraid
  instead of writing intermediate files to the array during processing. -->
  <Config Name="Temp" Target="/tmp/remuxarr" Default="/tmp/remuxarr-temp" Mode="rw" Description="FFmpeg staging directory. Keep under /tmp so it stays RAM-backed." Type="Path" Display="always" Required="true" Mask="false"/>

  <!-- Recycle bin for "revert to original". Holds only the tracks a job
  removed, never the video, so it is normally a small fraction of each file
  — but size it for the retention window (7 days / 20GB by default, both
  changeable in Settings).

  Required="false" deliberately: leaving it unmapped turns the recycle bin
  off and the app says so, which is the correct outcome for anyone who does
  not want it. Do NOT give this a default under /tmp — that is RAM-backed on
  Unraid and the retention window would not survive a reboot. -->
  <Config Name="Recycle Bin" Target="/recycle" Default="/mnt/user/appdata/remuxarr/recycle" Mode="rw" Description="Holds revert-to-original data: the audio and subtitle tracks removed by a job, so files can be put back. Leave empty to disable. Must NOT be under /tmp — that is RAM-backed and would be lost on reboot." Type="Path" Display="always" Required="false" Mask="false"/>

  <!-- Time zone. Unraid does not pass TZ to containers itself — its own
  Date & Time setting governs the host, not what a container's clock reads —
  so without this field a Community Apps install runs on UTC with no way to
  change it short of adding the variable by hand.

  That matters because TZ decides when scheduled work fires: scan times and
  the Plex analyze window are matched against the container's local clock.
  It does NOT affect displayed timestamps, which are stored in UTC and
  converted by the browser. That asymmetry is the reason this needs saying
  in the description rather than just existing as a field: leaving it empty
  produces no visible symptom at all. Every clock in the UI reads correctly
  and the only evidence is a scan starting at the wrong hour.

  Default is deliberately empty. Seeding a city would be confidently wrong
  for most people, which is worse than being plainly unset, and seeding
  Etc/UTC would look configured while changing nothing. Required="false"
  because an empty TZ is a working container, just one on UTC.

  No Dockerfile change is needed to support this: python:3.12-slim installs
  tzdata as a base runtime dependency, so /usr/share/zoneinfo is present.
  Without it glibc would fall back to UTC and this field would silently do
  nothing. -->
  <Config Name="TZ" Target="TZ" Default="" Mode="" Description="Your IANA time zone, e.g. Europe/London or America/New_York. Leave empty and the container runs on UTC, which means scheduled scans and the Plex analyze window fire on UTC rather than your local time. Timestamps shown in the web UI are converted by your browser and are correct either way." Type="Variable" Display="always" Required="false" Mask="false"/>
</Container>
