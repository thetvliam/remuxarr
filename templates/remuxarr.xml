<Container version="2">
  <!-- Delete this file if your repository does not ship Docker apps. -->
  <Name>Remuxarr</Name>
  <Repository>ghcr.io/thetvliam/remuxarr:latest</Repository>
  <Registry>https://ghcr.io/thetvliam/remuxarr</Registry>
  <Network>bridge</Network>

  <Shell>bash</Shell>
  <Privileged>false</Privileged>

  <!-- Optional but highly recommended: app icon -->
  <Icon>https://raw.githubusercontent.com/thetvliam/remuxarr/main/images_and_demo/logo-padding.png</Icon>

  <!-- Optional theme-specific icon overrides -->
  <!-- <Icon-black>https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_PLUGIN_REPO/main/icon-black.png</Icon-black> -->
  <!-- <Icon-white>https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_PLUGIN_REPO/main/icon-white.png</Icon-white> -->
  <!-- <Icon-azure>https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_PLUGIN_REPO/main/icon-azure.png</Icon-azure> -->
  <!-- <Icon-gray>https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_PLUGIN_REPO/main/icon-gray.png</Icon-gray> -->

  <!-- NOTE: The port in the entry ALWAYS refers to the container port, not the host port-->
  <WebUI>http://[IP]:[PORT:9191]</WebUI>

  <!-- Plain text description -->
  <Overview>Cleans up a Sonarr/Radarr media library for better playback compatibility without ever re-encoding video. Remuxes containers, drops audio/subtitle tracks outside your kept languages, and fixes broken language metadata — all through lossless stream copying. Video is never touched.</Overview>

  <!-- NOTE: Either Support or Project is REQUIRED -->
  <!-- Support forum -->
  <Support>https://github.com/thetvliam/remuxarr/issues</Support>

  <!-- Project page -->
  <Project>https://github.com/thetvliam/remuxarr</Project>

  <!-- Raw URL to this exact template file -->
  <TemplateURL>https://raw.githubusercontent.com/thetvliam/remuxarr/main/templates/remuxarr.xml</TemplateURL>

  <!-- Readme first file -->
  <ReadMe>https://raw.githubusercontent.com/thetvliam/remuxarr/main/README.md</ReadMe>

  <!-- Optional Discord community URL -->
  <!-- <Discord>https://discord.gg/YOUR_DISCORD_INVITE_CODE</Discord> -->

  <!-- Optional Reddit community URL -->
  <!-- <Reddit>https://www.reddit.com/r/YOUR_REDDIT_COMMUNITY</Reddit> -->

  <!-- Optional Facebook community URL -->
  <!-- <Facebook>https://www.facebook.com/YOUR_FACEBOOK_PAGE</Facebook> -->



  <!-- Valid category entries can be generated from the Application Categorizer plugin available in Apps -->
  <Category>Productivity MediaApp:Video Tools:Utilities</Category>

  <!-- Optional extra app search terms -->
  <ExtraSearchTerms>remux</ExtraSearchTerms>

  <!-- Optional system requirements text -->
  <!-- <Requires>Internet access for first run</Requires> -->

  <!-- Optional changelog text -->
  <!--<Changes>Initial release</Changes> -->

  <!-- Optional date (YYYY-MM-DD or YYYY-MM-DD HH:MM:SS) -->
  <!--<Date>2026-01-01</Date> -->

  <!-- Optional: set to true if this is a beta container -->
  <!-- <Beta>true</Beta> -->

  <!-- Minimum and maximum Unraid version.-->
  <MinVer>6.1</MinVer>
  <!-- <MaxVer>7.3</MaxVer>-->

  <!-- Optionally set this if this container is deprecated for all OS versions -->
  <!-- <Deprecated>true</Deprecated> -->

  <!-- Optional: deprecate starting with a specific OS version -->
  <!-- <DeprecatedMaxVer>7.2</DeprecatedMaxVer> -->

  <!-- License of the container-->
  <License>MIT</License>

  <!-- Screenshots -->
  <!-- You can add multiple screenshots by adding multiple <Screenshot> tags -->
  <Screenshot>https://raw.githubusercontent.com/thetvliam/remuxarr/main/images_and_demo/screenshot.png</Screenshot>

  <!-- Video. YouTube URLs are highly recommended -->
  <!-- You can add multiple videos by adding multiple <Video> tags -->
  <!-- <Video>https://www.youtube.com/watch?v=YOUR_YOUTUBE_VIDEO_ID</Video> -->

  <!-- Optional release branch selectors -->
  <!--
  <DefaultTagDescription>Stable releases</DefaultTagDescription>
  <Branch>
  <Tag>main</Tag>
  <TagDescription>Latest commits from main branch</TagDescription>
  </Branch>
  -->

  <!-- v2 templates should define ports/paths/variables with Config entries -->
  <Config Name="WebUI" Target="9191" Default="9191" Mode="tcp" Description="Web UI + API port" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/remuxarr/config" Mode="rw" Description="Persistent config files." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Movies" Target="/media/movies" Default="/mnt/user/media/movies" Mode="rw" Description="Your movies library" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="TV Shows" Target="/media/tv" Default="/mnt/user/media/tv" Mode="rw" Description="Your TV library" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Temp" Target="/tmp/remuxarr" Default="/tmp/remuxarr-temp" Mode="rw" Description="FFmpeg staging directory — leave under /tmp so it stays RAM-backed" Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Webhook Debounce Seconds" Target="REMUXARR_WEBHOOK_DEBOUNCE_SECONDS" Default="10" Description="Seconds to wait after the last Sonarr/Radarr webhook for a file before queuing it. Increase for very large season packs on slow disks." Type="Variable" Display="advanced" Required="false" Mask="false"/>

</Container>
